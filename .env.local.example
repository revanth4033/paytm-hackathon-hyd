# Copy to .env.local and fill in to enable real AI calls.
# Every touchpoint defaults to mocked (USE_MOCK_*=true) when unset, so the
# app runs with zero keys out of the box.

ANTHROPIC_API_KEY=
SARVAM_API_KEY=

# Flip to "false" one at a time as each touchpoint is verified working.
USE_MOCK_REMINDER=true
USE_MOCK_TTS=true
USE_MOCK_OCR=true
USE_MOCK_CHAT=true
